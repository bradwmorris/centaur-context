# Must point to the centaur_context logical database in deployed environments.
DATABASE_URL=postgres://centaur_context_app:change-me@centaur-centaur-postgres:5432/centaur_context

# Local-human listener. Expose only with a localhost port-forward.
HUMAN_ADDR=0.0.0.0:8080

# ClusterIP Service exposes only this authenticated listener.
AGENT_ADDR=0.0.0.0:8081
AGENT_API_TOKEN=replace-through-kubernetes-secret

# Internal Context Curator listener. Never expose to agent sandboxes.
CURATOR_ADDR=0.0.0.0:8083
CURATOR_API_TOKEN=replace-with-a-distinct-kubernetes-secret

# Optional permanent organization Source-intake listener. Enable only for an
# overlay that grants this distinct token to its exact workflow principal.
# SOURCE_INTAKE_ADDR=0.0.0.0:8086
# SOURCE_INTAKE_API_TOKEN=replace-with-a-distinct-32-character-secret
# Optional agent Theme listener. This distinct credential can propose new vocabulary
# entries and assign or unassign existing approved Themes; it cannot approve Themes.
# THEME_PROPOSAL_ADDR=0.0.0.0:8087
# THEME_PROPOSAL_API_TOKEN=replace-with-a-distinct-32-character-secret

# Approved Slack workspace/channel pairs. Wildcards are rejected.
INGEST_ADDR=0.0.0.0:8082
CHAT_INGEST_API_TOKEN=replace-with-a-distinct-kubernetes-secret
APPROVED_SLACK_SURFACES=T_EXAMPLE:C_EXAMPLE
INTERACTION_INACTIVITY_SECONDS=600
INACTIVITY_POLL_SECONDS=30

# PostgreSQL full-text configuration. The language-neutral default is simple.
# Supported values: simple, dutch, english, french, german, italian, portuguese, spanish.
TEXT_SEARCH_CONFIG=simple

# Optional provider-independent, OpenAI-compatible Object embeddings.
# Supply all four values or none. External network access is disabled by the
# default deployment policy and must be added explicitly for the chosen provider.
# EMBEDDING_API_URL=https://provider.example/v1/embeddings
# EMBEDDING_API_TOKEN=replace-through-kubernetes-secret
# EMBEDDING_MODEL=provider-model-name
# EMBEDDING_DIMENSIONS=1536
# Use shared when the provider uses one request shape, or typed to send
# search_document and search_query input_type values.
# EMBEDDING_INPUT_MODE=shared
# EMBEDDING_POLL_SECONDS=5

# Optional Context Curator model. The default transport is Centaur's private
# ChatGPT-subscription inference boundary. Set direct_api only for rollback.
# Supply all values or none; with none, queued runs are not processed automatically.
# CURATOR_MODEL_TRANSPORT=centaur_subscription
# CURATOR_MODEL_API_URL=http://centaur-api-rs:8080/api/internal/context-curator/infer
# CURATOR_MODEL_API_TOKEN=replace-with-centaur-context-api-key
# CURATOR_MODEL=gpt-5.6-luna
# CURATOR_PROMPT_VERSION=centaur-context-curator-v1
# CURATOR_POLL_SECONDS=5
# CURATOR_MODEL_TIMEOUT_SECONDS=210

STATIC_DIR=web/dist
RUST_LOG=centaur_context=info,tower_http=info
