# Must point to the centaur_os logical database in deployed environments.
DATABASE_URL=postgres://centaur_os_app:change-me@centaur-centaur-postgres:5432/centaur_os

# Local-human listener. Expose only with a localhost port-forward.
HUMAN_ADDR=0.0.0.0:8080

# ClusterIP Service exposes only this authenticated listener.
AGENT_ADDR=0.0.0.0:8081
AGENT_API_TOKEN=replace-through-kubernetes-secret

# Internal Context Curator listener. Never expose to agent sandboxes.
CURATOR_ADDR=0.0.0.0:8083
CURATOR_API_TOKEN=replace-with-a-distinct-kubernetes-secret

# Optional provider-independent, OpenAI-compatible Curator model.
# Supply all four values or none; with none, queued runs are not processed automatically.
# CURATOR_MODEL_API_URL=https://provider.example/v1/chat/completions
# CURATOR_MODEL_API_TOKEN=replace-through-kubernetes-secret
# CURATOR_MODEL=provider-model-name
# CURATOR_PROMPT_VERSION=centaur-os-curator-v1

STATIC_DIR=web/dist
RUST_LOG=centaur_os=info,tower_http=info
