{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bradwmorris/centaur-context/contract/context-contract.schema.json",
  "title": "Centaur Context contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract_version", "ontology_version", "tool_version", "object_types", "connection_kinds", "tools", "limits", "rules"],
  "properties": {
    "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "ontology_version": {"type": "string", "minLength": 1},
    "tool_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "object_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interactive_write", "fields"],
        "properties": {
          "interactive_write": {"type": "boolean"},
          "fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "connection_kinds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_search", "context_read", "context_apply"],
      "properties": {
        "context_search": {"$ref": "#/$defs/tool"},
        "context_read": {"$ref": "#/$defs/tool"},
        "context_apply": {"$ref": "#/$defs/tool"}
      }
    },
    "limits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "rules": {"type": "object", "additionalProperties": {"type": "boolean"}}
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "read_only", "input", "output"],
      "properties": {
        "operation": {"type": "string", "minLength": 1},
        "read_only": {"type": "boolean"},
        "idempotent": {"type": "boolean"},
        "input": {"$ref": "#/$defs/shape"},
        "output": {"$ref": "#/$defs/shape"}
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "optional": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
