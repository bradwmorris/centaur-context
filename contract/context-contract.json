{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_version": "1.1.0",
  "ontology_version": "3",
  "tool_version": "1.1.0",
  "object_types": {
    "task": {
      "interactive_write": true,
      "creation_requirements": "Assigned active User; agent/system creation requires due_at. Code work requires canonical GitHub issue. Legacy gaps must be repaired before execution.",
      "fields": [
        "status",
        "priority",
        "owner_object_id",
        "agent_suitable",
        "blocked_reason",
        "due_at",
        "completed_at",
        "work_kind",
        "github_issue_url",
        "brief_markdown"
      ]
    },
    "entity": {
      "interactive_write": true,
      "fields": [
        "entity_kind"
      ]
    },
    "source": {
      "interactive_write": true,
      "fields": [
        "source_kind",
        "canonical_uri",
        "byline",
        "publisher",
        "published_at",
        "published_at_precision",
        "last_accessed_at",
        "original_language",
        "original_media_type",
        "original_artifact_reference"
      ]
    },
    "note": {
      "interactive_write": true,
      "fields": [
        "content",
        "content_format",
        "intent",
        "source_artifact_id",
        "source_locator"
      ]
    },
    "theme": {
      "interactive_write": true,
      "fields": [
        "slug"
      ]
    },
    "chat": {
      "interactive_write": true,
      "fields": [
        "channel_name"
      ]
    },
    "user": {
      "interactive_write": true,
      "fields": [
        "user_kind",
        "identities"
      ]
    },
    "memory": {
      "interactive_write": true,
      "fields": [
        "happened_at"
      ]
    }
  },
  "connection_kinds": [
    "involves",
    "about",
    "related_to",
    "depends_on",
    "derived_from",
    "themed"
  ],
  "description_policy": {
    "max_characters": 600,
    "preferred_sentences": 2,
    "current_snapshot_not_log": true,
    "refresh_when_materially_stale": true,
    "guidance": [
      "Directly identify the Object in plain language.",
      "Titles identify concrete subjects; descriptions add distinguishing supported meaning, normally in one or two sentences. Do not repeat titles, narrate storage, stuff synonyms or use IDs as the primary meaning.",
      "Entity metadata describes identity independently of a Source. Put participation and relevance on explained Connections; qualify time-sensitive affiliations.",
      "Use only facts justified by the request, retrieved Context, or recorded provenance.",
      "Keep canonical source content, task briefs, evidence, Connection explanations, provenance, and change history in their existing records."
    ],
    "examples": {
      "task": "Define and test concise Object descriptions across creation, capture and maintenance paths.",
      "entity": "Jane Lee studies how agents retain and retrieve useful memories.",
      "source": "An interview with Jane Lee comparing retrieval evaluation methods for agent memory.",
      "note": "The current embedding trigger already invalidates vectors after title or description changes. Recorded to prevent a redundant re-indexing subsystem.",
      "theme": "How canonical Objects are found and ranked using their titles, descriptions and relationships.",
      "chat": "Alex and a research assistant compared retrieval methods and selected a metadata-only evaluation plan.",
      "user": "A research assistant that helps review sources and prepare evidence-backed notes.",
      "memory": "Alex approved the retrieval evaluation plan after reviewing its synthetic test cases."
    }
  },
  "tools": {
    "context_search": {
      "operation": "search",
      "task_filters": {
        "required": [],
        "optional": [
          "owner_object_id",
          "statuses",
          "priority",
          "due_before",
          "ready",
          "cursor"
        ]
      },
      "read_only": true,
      "input": {
        "required": [
          "query"
        ],
        "optional": [
          "object_types",
          "limit",
          "lexical_only",
          "task_filters"
        ]
      },
      "output": {
        "required": [
          "objects"
        ]
      }
    },
    "context_read": {
      "operation": "read",
      "read_only": true,
      "input": {
        "required": [
          "object_ids"
        ],
        "optional": [
          "include",
          "artifact_windows",
          "note_windows"
        ]
      },
      "output": {
        "required": [
          "objects",
          "artifact_windows",
          "note_windows"
        ]
      }
    },
    "context_apply": {
      "operation": "atomic_apply",
      "read_only": false,
      "idempotent": true,
      "input": {
        "required": [
          "contract_version",
          "idempotency_key",
          "operations"
        ],
        "optional": [
          "chat_object_id",
          "validate_only"
        ]
      },
      "operations": {
        "create_object": {
          "required": [
            "local_ref",
            "kind",
            "title",
            "description"
          ],
          "optional": [
            "provenance",
            "fields"
          ]
        },
        "update_object": {
          "required": [
            "object_id",
            "expected_revision"
          ],
          "optional": [
            "changes"
          ]
        },
        "archive_object": {
          "required": [
            "object_id",
            "expected_revision"
          ]
        },
        "create_connection": {
          "required": [
            "source",
            "kind",
            "target",
            "description"
          ],
          "optional": [
            "provenance"
          ]
        },
        "update_connection": {
          "required": [
            "connection_id",
            "expected_revision"
          ],
          "optional": [
            "kind",
            "description",
            "provenance"
          ]
        },
        "archive_connection": {
          "required": [
            "connection_id",
            "expected_revision"
          ]
        },
        "append_artifact": {
          "required": [
            "object",
            "expected_revision",
            "kind"
          ],
          "optional": [
            "title",
            "content",
            "uri",
            "media_type",
            "language",
            "capture_outcome",
            "capture_reason",
            "metadata",
            "supersedes_artifact_id"
          ]
        },
        "promote_source_artifact": {
          "required": [
            "source_id",
            "expected_revision",
            "artifact_id",
            "expected_sha256"
          ]
        },
        "restore_object": {
          "required": [
            "object_id",
            "expected_revision"
          ]
        },
        "restore_connection": {
          "required": [
            "connection_id",
            "expected_revision"
          ]
        },
        "rebuild_derived": {
          "required": [
            "object_id",
            "expected_revision"
          ]
        },
        "correct_evidence": {
          "required": [
            "object_id",
            "expected_revision",
            "target_type",
            "target_id",
            "reason",
            "representation"
          ]
        },
        "reassign_identity": {
          "required": [
            "object_id",
            "expected_revision",
            "target_object_id",
            "expected_target_revision",
            "identity_id",
            "reason"
          ]
        },
        "reassign_chat": {
          "required": [
            "object_id",
            "expected_revision",
            "target_object_id",
            "expected_target_revision",
            "reason"
          ]
        }
      },
      "object_reference": {
        "exactly_one_of": [
          "object_id",
          "local_ref"
        ]
      },
      "output": {
        "required": [
          "replayed",
          "validated_only",
          "request_hash",
          "contract_version",
          "tool_version",
          "run_id",
          "event_ids",
          "results"
        ]
      }
    }
  },
  "limits": {
    "search_query_characters": 1000,
    "search_results": 100,
    "read_objects": 20,
    "apply_operations": 20,
    "title_characters": 300,
    "description_characters": 600,
    "connection_description_characters": 1000,
    "artifact_window_characters": 20000,
    "note_content_characters": 100000
  },
  "rules": {
    "new_objects_require_connection": true,
    "standalone_note_intents": [
      "idea",
      "fact",
      "insight",
      "question"
    ],
    "verified_chat_adds_provenance_connection": true,
    "object_kind_is_immutable": true,
    "updates_require_expected_revision": true,
    "unknown_fields_fail": true,
    "exact_connection_repeat_is_replay": true,
    "different_connection_assertion_merges_provenance": true,
    "protected_is_background_curation_preference": true,
    "evidence_corrections_preserve_original": true
  }
}
